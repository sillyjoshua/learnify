{
  "name": "learnify",
  "version": "0.2.1",
  "description": "A free coding-learning app",
  "main": "electron/main.cjs",
  "author": "Learnify contributors",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "dist:win": "electron-builder --win nsis --x64 --publish never"
  },
  "devDependencies": {
    "electron": "^34.3.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "app.learnify.desktop",
    "productName": "Learnify",
    "directories": { "output": "dist" },
    "files": ["index.html", "electron/**/*", "package.json"],
    "win": { "target": [{ "target": "nsis", "arch": ["x64"] }], "artifactName": "Learnify-Setup-${version}.${ext}" },
    "nsis": { "oneClick": false, "allowToChangeInstallationDirectory": true, "createDesktopShortcut": true, "createStartMenuShortcut": true }
  }
}